# سياق البناء = جذر المستودع (docker-compose.prod.yml) لأن سكربت الخطوط في scripts/
FROM node:22-alpine AS build

WORKDIR /repo

COPY frontend/package.json frontend/package-lock.json frontend/
RUN cd frontend && npm ci

# خطوط QPC V2 (604 صفحة) غير مُلتزَمة في git — تُجلب أثناء البناء. يفشل البناء إن فشل الجلب.
COPY scripts/fetch-mushaf-assets.mjs scripts/
RUN node scripts/fetch-mushaf-assets.mjs

COPY frontend/ frontend/
RUN cd frontend && npm run build

# الصورة النهائية: Caddy يخدم الملفات الثابتة ويمرّر /api إلى الباك-إند.
# ملف Caddyfile يُركَّب من المضيف (deploy/Caddyfile يولّده المثبّت).
FROM caddy:2-alpine
COPY --from=build /repo/frontend/dist /srv
