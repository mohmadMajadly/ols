# نسخ هذا الملف إلى .env وتعبئة القيم الحقيقية قبل التشغيل
# Copy this file to .env and fill in real values before running.

# ---- PostgreSQL ----
POSTGRES_USER=ols
POSTGRES_PASSWORD=ols_dev_password
POSTGRES_DB=ols
# يستخدمها الباك-إند للاتصال بقاعدة البيانات داخل شبكة Docker
DATABASE_URL=postgresql+psycopg://ols:ols_dev_password@db:5432/ols

# ---- Backend security ----
# مفتاح سري لتوقيع JWT - يجب أن يكون طويلاً وعشوائياً في الإنتاج
SECRET_KEY=change_me_to_a_long_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
# يجب أن تكون true خلف HTTPS في الإنتاج، false في بيئة التطوير المحلية
COOKIE_SECURE=false

# ---- Seed admin ----
# ينشأ تلقائياً عند أول تشغيل إذا لم يوجد أي مستخدم بدور admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# ---- Media storage ----
# مسار تخزين ملفات الوسائط (تسجيلات الجلسات) داخل الحاوية، على named volume "media"
MEDIA_ROOT=/data/media
